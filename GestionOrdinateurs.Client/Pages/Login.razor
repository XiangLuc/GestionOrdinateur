@page "/login"

@inject IHttpClientFactory Factory
@inject ISessionStorageService SessionStorage
@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthProvider

<PageTitle>Connexion</PageTitle>

<h3>Connexion</h3>

<InputText @bind-Value="UserLogin" class="form-control" placeholder="Login" />
<InputText @bind-Value="UserPassword" type="password" class="form-control mt-2" placeholder="Mot de passe" />

<button class="btn btn-primary mt-2" @onclick="SeConnecter">
    Se connecter
</button>

@if (!string.IsNullOrEmpty(Erreur))
{
    <div class="alert alert-danger mt-2">@Erreur</div>
}

@code
{
    private string UserLogin = "";
    private string UserPassword = "";
    private string Erreur = "";

    private async Task SeConnecter()
    {
        Erreur = "";
        var client = Factory.CreateClient("AuthentificationApi");

        var response = await client.PostAsJsonAsync("authentication/login-keycloak", new { Login = UserLogin, Password = UserPassword });

        if (!response.IsSuccessStatusCode)
        {
            Erreur = "Login ou mot de passe incorrect";
            return;
        }

        var token = await response.Content.ReadAsStringAsync();
        await SessionStorage.SetItemAsync("jwtToken", token);
        AuthProvider.NotifyUserAuthentication(token);
        Navigation.NavigateTo("/");
    }
}
