{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://localhost:5010"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ordinateursRoute": {
        "ClusterId": "gestionOrdinateursApi",
        "Match": {
          "Path": "/api/ordinateurs/{**catch-all}"
        }
      },
      "reparationsRoute": {
        "ClusterId": "gestionOrdinateursApi",
        "Match": {
          "Path": "/api/reparations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestionOrdinateursApi": {
        "Destinations": {
          "gestionOrdinateursService": {
            "Address": "http://localhost:5299/"
          }
        }
      }
    }
  }
}
